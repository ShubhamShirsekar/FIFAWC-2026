.venv

# Ignore everything
*

# Allow directories (negate directory ignore)
!*/

# Keep this file
!.gitignore

# Allow data/referees and all its contents
!/data/
!/data/referees/
!/data/referees/**

# Allow src and the specific files/directories we want
!/src/requirements.py
!/src/referee-analysis/
!/src/referee-analysis/**
!/src/bubble-detector/
!/src/bubble-detector/**

# Keep the virtual environment ignored
.venv